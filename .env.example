# Copy this file to .env and fill it in. Never commit .env.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
# Leave both empty to run on built-in demo data.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# The AI reads the invoices and writes the reminder drafts. Fill in any of these.
# Several keys per provider are fine: separate them with commas. When one is
# rate limited or rejected the next is used. Order is set by LLM_ORDER below.
GEMINI_API_KEYS=
ANTHROPIC_API_KEYS=
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-flash-latest   # tried in this order
# ANTHROPIC_MODEL=claude-haiku-5-5
# Which provider goes first. Swap the words to switch: gemini,anthropic or anthropic,gemini
LLM_ORDER=anthropic,gemini

# Optional
# PORT=3000
# APP_PASSWORD=choose-something   # asks for a password before showing anything
# ACCESS_KEY=long-random-string   # keep secret. `npm run link -- https://your-app.onrender.com` prints a share link derived from it that skips the password
# AI_CALLS_PER_HOUR=30            # per visitor, so a shared link cannot run up your bill
# DATA_DIR=./data                 # where the reminder log is kept
